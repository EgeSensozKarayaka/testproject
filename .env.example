# Local development only. Copy to .env if you want to override defaults.
POSTGRES_DB=site_monitor
POSTGRES_USER=site_monitor
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_PORT=15432
# Host-side db:* commands construct this URL from the values above when omitted.
# DATABASE_URL=postgresql://site_monitor:local_dev_only_change_me@127.0.0.1:15432/site_monitor
# Destructive db:reset additionally requires an explicit one-command acknowledgement.
ALLOW_DATABASE_RESET=false

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

API_PORT=13000
WEB_PORT=15173
TARGET_SIMULATOR_PORT=4010
PREDICTOR_PORT=18000

# Probe egress is public-only. The exact development origin is the sole private-network
# exception used by the Docker target simulator; production rejects this setting.
PROBE_ALLOWED_PORTS=80,443,4010
PROBE_DEV_ALLOWED_ORIGINS=http://target-simulator:4010
PROBE_MAX_REDIRECTS=5
PROBE_MAX_RESPONSE_BYTES=1048576
PROBE_MAX_HEADER_BYTES=16384
PROBE_CONNECT_TIMEOUT_MS=10000
PROBE_MAX_DNS_RESULTS=16
PROBE_USER_AGENT=SiteAvailabilityMonitor/0.1

# Monitor worker queue, lease, and process-local concurrency limits. These are
# capacity controls, not a fixed product limit on the number of checks.
MONITOR_GLOBAL_CONCURRENCY=64
MONITOR_PER_OWNER_CONCURRENCY=32
MONITOR_PER_HOST_CONCURRENCY=4
MONITOR_CANDIDATE_BATCH_SIZE=128
MONITOR_SCHEDULE_BATCH_SIZE=64
MONITOR_SCHEDULER_POLL_MS=250
MONITOR_DISPATCH_POLL_MS=100
MONITOR_RECOVERY_POLL_MS=1000
MONITOR_FRESHNESS_POLL_MS=250
MONITOR_SCHEDULER_GRACE_MS=5000
MONITOR_HEARTBEAT_MS=5000
MONITOR_LEASE_GRACE_MS=15000
MONITOR_SHUTDOWN_GRACE_MS=30000
MONITOR_DB_POOL_SIZE=8

# Independent history projection and retention process. Every iteration is
# bounded; poll settings control throughput without imposing a check-count cap.
HOUSEKEEPING_DB_POOL_SIZE=4
HOUSEKEEPING_DISCOVERY_BATCH_SIZE=500
HOUSEKEEPING_DISCOVERY_POLL_MS=1000
HOUSEKEEPING_ROLLUP_BUCKET_BATCH_SIZE=60
HOUSEKEEPING_ROLLUP_POLL_MS=250
HOUSEKEEPING_PARTITION_POLL_MS=60000
HOUSEKEEPING_PURGE_BATCH_SIZE=250
HOUSEKEEPING_RETENTION_POLL_MS=30000
HOUSEKEEPING_SHUTDOWN_GRACE_MS=30000

# Durable REALTIME outbox relay. Revision 28 activates this destination after
# private browser stream, relay and capacity acceptance; do not disable it by
# editing migration history.
REALTIME_DB_POOL_SIZE=4
REALTIME_BATCH_SIZE=100
REALTIME_POLL_MS=100
REALTIME_LEASE_SECONDS=30
REALTIME_MAX_DISPATCH_ATTEMPTS=5
REALTIME_RETRY_BASE_SECONDS=2
REALTIME_RETRY_CAP_SECONDS=60
REALTIME_SHUTDOWN_GRACE_MS=15000

# Private SSE API replica limits. These are per replica; production edge limits
# provide the deployment-wide ceiling.
REALTIME_API_GLOBAL_CONNECTION_LIMIT=1000
REALTIME_API_OWNER_CONNECTION_LIMIT=20
REALTIME_API_SESSION_CONNECTION_LIMIT=5
REALTIME_API_IP_CONNECTION_LIMIT=50
REALTIME_API_QUEUE_EVENT_LIMIT=256
REALTIME_API_QUEUE_BYTE_LIMIT=1048576
REALTIME_API_HEARTBEAT_MS=15000
REALTIME_API_SESSION_REVALIDATE_MS=60000
REALTIME_API_SESSION_REVALIDATE_BATCH_SIZE=100
REALTIME_API_LISTENER_GRACE_MS=5000
REALTIME_API_PROJECTION_QUEUE_LIMIT=2048
REALTIME_API_PROJECTION_CONCURRENCY=8
REALTIME_API_SHUTDOWN_GRACE_MS=5000

# Deployment safety quotas; use the literal "unlimited" only deliberately.
CHECKS_PER_OWNER_LIMIT=500
GROUPS_PER_OWNER_LIMIT=100
MAINTENANCE_WINDOWS_PER_OWNER_LIMIT=500

# Private history queries fail closed when projection lag exceeds the bounded
# raw-source tail. These settings cap query cost and retry behavior.
HISTORY_STATEMENT_TIMEOUT_MS=2000
HISTORY_MINUTE_RAW_TAIL_SECONDS=900
HISTORY_HOUR_RAW_TAIL_SECONDS=7200
HISTORY_CURSOR_TTL_SECONDS=900
HISTORY_RETRY_AFTER_SECONDS=5

# Production must provide independent random 32-byte base64 keys. Local development uses
# deterministic non-secret fallbacks when these variables are absent.
# AUTH_CSRF_KEY_BASE64=
# AUTH_RATE_LIMIT_KEY_BASE64=
# AUTH_EMAIL_KEY_BASE64=
AUTH_CSRF_KEY_VERSION=local-v1
AUTH_EMAIL_KEY_VERSION=local-v1
PUBLIC_WEB_URL=http://localhost:15173

# Notification worker durability, retry, and bounded SMTP throughput.
AUTH_EMAIL_FROM=Site Monitor <no-reply@site-monitor.local>
AUTH_EMAIL_POLL_INTERVAL_MS=1000
NOTIFICATION_DB_POOL_SIZE=6
NOTIFICATION_LEASE_SECONDS=60
NOTIFICATION_MAX_DISPATCH_ATTEMPTS=5
NOTIFICATION_MESSAGE_ID_DOMAIN=site-monitor.local
NOTIFICATION_RETRY_BASE_SECONDS=30
NOTIFICATION_RETRY_CAP_SECONDS=1800
NOTIFICATION_SHUTDOWN_GRACE_MS=15000
NOTIFICATION_SMTP_CONCURRENCY=4
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000
SMTP_TLS_MODE=none
