{
  "name": "site-availability-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "clean": "node scripts/clean.mjs",
    "contracts:check": "node scripts/generate-openapi.mjs --check",
    "contracts:generate": "node scripts/generate-openapi.mjs --write",
    "ci": "node scripts/run-ci.mjs",
    "db:migrate": "node scripts/database-command.mjs migrate",
    "db:reset": "node scripts/database-command.mjs reset",
    "db:seed": "node scripts/database-command.mjs seed",
    "dev": "concurrently --kill-others --names web,api,monitor,notification,housekeeping,realtime --prefix-colors blue,green,yellow,magenta,cyan,white \"pnpm --filter @site-monitor/web dev\" \"pnpm --filter @site-monitor/api dev\" \"pnpm --filter @site-monitor/monitor-worker dev\" \"pnpm --filter @site-monitor/notification-worker dev\" \"pnpm --filter @site-monitor/housekeeping-worker dev\" \"pnpm --filter @site-monitor/realtime-worker dev\"",
    "dev:infra": "docker compose up --detach --wait postgres mailpit target-simulator",
    "dev:infra:down": "docker compose down",
    "dev:prediction": "docker compose --profile prediction up --build predictor",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node scripts/run-lint.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:capacity": "node scripts/run-vitest.mjs capacity",
    "test:e2e": "pnpm test:e2e:prepare && playwright test",
    "test:e2e:prepare": "pnpm --filter @site-monitor/notifications... build",
    "test:history-capacity": "node scripts/run-vitest.mjs history-capacity",
    "test:integration": "node scripts/run-vitest.mjs integration",
    "test:unit": "node scripts/run-vitest.mjs unit",
    "typecheck": "node scripts/run-typecheck.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "nodemailer": "10.0.16",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
